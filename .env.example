# Docker's Kafka host port; keep KAFKA_BOOTSTRAP_SERVERS in sync when changing it.
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Local broker heap and container budget, including the Kafka log page cache.
KAFKA_HEAP_OPTS="-Xms512m -Xmx1g"
KAFKA_CONTAINER_MEMORY=3g
# Docker's host port; keep REDIS_URL in sync when changing it.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Leave headroom for AOF rewrites and snapshots inside the container.
REDIS_MAXMEMORY=512mb
REDIS_CONTAINER_MEMORY=1280m
# Public Mapbox browser token (pk.). The presentation uses http://localhost:8050/.
MAPBOX_ACCESS_TOKEN=
TOMTOM_API_KEY=
H3_RESOLUTION=8
WINDOW_DURATION=1 minute
WINDOW_SLIDE=10 seconds
WATERMARK_DELAY=2 minutes
REDIS_TTL_SECONDS=900
SPARK_CHECKPOINT_ROOT=checkpoints/worldcup
# Keep existing checkpoint shuffle partition counts and state store settings on restart.
SPARK_TRIGGER_INTERVAL="5 seconds"
SPARK_MAX_OFFSETS_PER_TRIGGER=250000
SPARK_SHUFFLE_PARTITIONS=4
# Choose rocksdb only when initializing a fresh checkpoint.
SPARK_STATE_STORE=hdfs
# Optional streaming progress and sink metrics in JSON Lines format.
SPARK_METRICS_PATH=
STREAM_ID=worldcup-demo-v1
ALERT_HIGH=0.85
ALERT_LOW=0.65
